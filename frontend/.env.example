# Frontend Vite environment (loaded from frontend/ by Vite, not the repo root).
# Copy to frontend/.env only when you need non-default local values.

# Proxy target for `npm run dev` (browser still calls relative /api/...).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Leave empty for ordinary development so requests stay same-origin:
#   /api/v1/health/live  -> Vite proxy -> http://127.0.0.1:8000/api/v1/health/live
# An absolute value is a deliberate override (not recommended for local/Docker defaults).
VITE_API_BASE_URL=
