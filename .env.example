# Zorqen Research — backend and Docker Compose example environment (no real secrets)
# Copy to .env at the repository root and adjust for local development.
# Frontend Vite variables belong in frontend/.env — see frontend/.env.example.

ZORQEN_ENVIRONMENT=development
ZORQEN_LOG_LEVEL=INFO

# API
ZORQEN_API_HOST=127.0.0.1
ZORQEN_API_PORT=8000

# PostgreSQL (async driver URL for the application)
ZORQEN_DATABASE_URL=postgresql+asyncpg://zorqen:zorqen@127.0.0.1:5432/zorqen_research

# Synchronous URL used by Alembic migrations (psycopg)
ZORQEN_DATABASE_URL_SYNC=postgresql+psycopg://zorqen:zorqen@127.0.0.1:5432/zorqen_research

# Worker idle/poll interval in seconds
ZORQEN_WORKER_IDLE_INTERVAL_SECONDS=5.0

# Artifact root (relative path; resolved from the process working directory)
ZORQEN_ARTIFACT_ROOT=artifacts

# Optional Compose ports and Postgres credentials
# POSTGRES_USER=zorqen
# POSTGRES_PASSWORD=zorqen
# POSTGRES_DB=zorqen_research
# POSTGRES_PORT=5432
# API_PORT=8000
# FRONTEND_PORT=5173
#
# Do NOT set VITE_API_BASE_URL here for ordinary Docker use.
# The frontend image defaults to same-origin /api (nginx proxy).
# Intentional build override:
#   docker compose build --build-arg VITE_API_BASE_URL=https://api.example.com frontend
