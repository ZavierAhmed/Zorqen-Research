# Zorqen Research — example environment (no real secrets)
# Copy to .env and adjust for local development.

ZORQEN_ENVIRONMENT=development
ZORQEN_LOG_LEVEL=INFO

# API
ZORQEN_API_HOST=127.0.0.1
ZORQEN_API_PORT=8000

# PostgreSQL (async driver URL for the application)
ZORQEN_DATABASE_URL=postgresql+asyncpg://zorqen:zorqen@127.0.0.1:5432/zorqen_research

# Synchronous URL used by Alembic migrations (psycopg)
ZORQEN_DATABASE_URL_SYNC=postgresql+psycopg://zorqen:zorqen@127.0.0.1:5432/zorqen_research

# Worker idle/poll interval in seconds
ZORQEN_WORKER_IDLE_INTERVAL_SECONDS=5.0

# Artifact root (relative path; resolved from the process working directory)
ZORQEN_ARTIFACT_ROOT=artifacts

# Frontend (Vite) — used by the frontend process only
VITE_API_BASE_URL=http://127.0.0.1:8000
